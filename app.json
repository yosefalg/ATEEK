{
  "expo": {
    "name": "عتيك",
    "slug": "ateek-marketplace",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/generated/icon.png",
    "splash": {"image": "./assets/generated/splash.png", "resizeMode": "contain", "backgroundColor": "#090A0F"},
    "android": {
      "package": "com.yosef.ateek",
      "versionCode": 15,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {"foregroundImage": "./assets/generated/adaptive-icon.png", "backgroundColor": "#090A0F"},
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "blockedPermissions": ["android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO"]
    },
    "ios": {"supportsTablet": true, "bundleIdentifier": "com.yosef.ateek", "buildNumber": "15"},
    "plugins": [
      "expo-localization",
      ["expo-image-picker", {"photosPermission": "يحتاج عتيك للوصول إلى الوسائط التي تختارها لإضافتها إلى الإعلانات والريلز."}],
      ["expo-location", {"locationWhenInUsePermission": "يستخدم عتيك موقعك أثناء الاستخدام لعرض الإعلانات الأقرب إليك وإضافة موقع تقريبي لإعلانك."}],
      "expo-secure-store",
      "expo-video"
    ]
  }
}
