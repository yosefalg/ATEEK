{
  "expo": {
    "name": "عتيك",
    "slug": "ateek-marketplace",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/generated/icon.png",
    "splash": {
      "image": "./assets/generated/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F1A"
    },
    "android": {
      "package": "com.yosef.ateek",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/adaptive-icon.png",
        "backgroundColor": "#0B1F1A"
      },
      "permissions": ["READ_MEDIA_IMAGES"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yosef.ateek",
      "buildNumber": "2"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج عتيك للوصول إلى الصور لإضافتها إلى إعلانك."
        }
      ],
      "expo-secure-store"
    ]
  }
}
